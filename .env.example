# Cursor API key used for every SDK call.
# Set this to skip the in-app sign-in screen entirely.
# Create one at https://cursor.com/dashboard/api (user key) or in Team settings
# (service account key). Team Admin keys are not supported by the SDK.
CURSOR_API_KEY=

# Secret used to encrypt the API key into the session cookie.
# Optional: without it a random per-process key is generated, which means every
# restart signs users out. Set it in any deployment with more than one instance.
# Generate with: openssl rand -hex 32
CLEO_SESSION_SECRET=
